{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chao-ngo-player",
  "account_id": "c24fed68f8dc59cc339bd821d215bba8",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chao-ngo",
      "database_id": "420393d7-6abf-4a43-bc4d-4f5f94a5b7e9"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PUBLIC_ASSETS",
      "bucket_name": "creativelabth-public"
    },
    {
      "binding": "PRIVATE_UPLOADS",
      "bucket_name": "creativelabth-private"
    }
  ]
,
  "main": "worker.ts",
  "triggers": { "crons": ["0 * * * *"] }
,
  "assets": { "directory": "dist/client", "not_found_handling": "none", "binding": "ASSETS" }
,
  "routes": [
    {
      "pattern": "chaongo.creativelabth.com",
      "custom_domain": true
    }
  ]
,
"vars": {
  "BETTER_AUTH_URL": "https://chaongo.creativelabth.com"
}
}
