{
  "name": "chao-ngo-player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev --port 3000",
    "build": "vinext build",
    "preview": "vinext start --port 3000",
    "deploy": "npm run build && vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:dry-run": "npm run build && vinext-cloudflare deploy --config dist/server/wrangler.json --dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "asset": "tsx scripts/upload-asset.ts",
    "content:import": "tsx scripts/import-node-zone.ts",
    "content:import:ka": "tsx scripts/import-ka-casefiles.ts",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "better-auth": "^1.7.5",
    "dotenv": "18.0.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "10.11.0",
    "miniflare": "^5.20260918.0-alpha",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript-eslint": "8.70.0",
    "vinext": "1.0.0-beta.10",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  }
}
